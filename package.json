    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "pg": "8.23.1",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
